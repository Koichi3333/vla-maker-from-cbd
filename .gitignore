# Generated by runs: smoke-test output, downloaded results, VLM images and answers
work/*
!work/.gitkeep

# Author's local agent rules (handoff notes, private environment); the public rules are CLAUDE.md
CLAUDE.local.md

# Secrets (tools/colab_secrets.py passes them through temporary files)
.secrets.json
secrets.json
*.secrets.json
.env
.env.*

# colab exec -f X.ipynb writes this next to the input
*_output.ipynb

# Large artifacts belong on Hugging Face or in a release, not in git
*.safetensors
*.tgz
*.tar.gz
*.tar
*.zip
*.mp4

# drivemount / auth logs from tools/ptyrun.py
dm.log
dm.in

# Python / editors / OS
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.idea/
.vscode/
*.swp
