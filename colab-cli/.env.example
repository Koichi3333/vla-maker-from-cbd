# Local machines: copy to colab-cli/.env (gitignored) and fill in what you use.
# tools/colab_secrets.py reads it; Codespaces users set Codespaces secrets instead.
#
#   cp colab-cli/.env.example colab-cli/.env && chmod 600 colab-cli/.env
#
# colab/start.sh ships HF_TOKEN to every session it creates (SECRETS=... to change).
# By hand, once per session:
#   python3 colab-cli/tools/colab_secrets.py -s vla HF_TOKEN

# For a short-lived token, skip this file and use (hidden prompt; --unset removes it):
#   python3 colab-cli/tools/colab_secrets.py --set HF_TOKEN

# Required for training and inference: Hugging Face token that can read
# nvidia/GR00T-N1.7-3B and the gated Cosmos-Reason2-2B backbone
HF_TOKEN=

# Optional: only for the VLM goal scripts run on this machine
# (vla/vlm_target.py, vla/vlm_goal_depth.py), never sent to Colab
GEMINI_API_KEY=
